loma 1.0
title "Showcase"
tempo 96
meter 4/4
key Dm

# One short file that uses every construct of the language.

track Lead ch=1 program=73
track Keys ch=2 program=4
track Bass ch=3 program=33
track Kit drums

pattern comp base=3 dur=/8 : (1 3 5) r (1 3 5)/4
pattern compB from comp : 1=(3 5 8){v=72} 3=(1 3 5)/4{a=stac}
pattern walk base=2 dur=/8 : 0 5 8 5-
swing shuffle grid=/8 : 0 36
voicing open base=3 : 1 5 10

section pickup
  bar A7 len=/4
    Lead{v=70}: A4/8x3/2 C#5/8x3/2 E5/8x3/2
end

section intro
  bar Dm9 tempo=96
    Keys{v=50>70 swing=shuffle}: use comp
    Bass{v=70}: use walk
    Kit{v=60}: kick/4 hat/8 hat/8 snare/4 hat/8 hat/8
  bar G13/B Dm7^1
    Keys{v=70>58}: *open/2 | use compB
    Bass: use walk
    Kit: kick/4 [snare hat]/4 kick/8 kick/8 snare/4{v=100}
end

section theme
  repeat 2
    bar Dm
      Lead{v=84}:
        "la" D5/8.{o=-6} E5/16{a=stac}
        "li" F5/16q G5/16q A5/16q G5/16q F5/16q
        bend=0>600/4 A5/4~{a=leg} A5/4 bend=0
      Keys{v=56}: use comp,compB
      Bass: D2/2~ D2/4 m45/4
      Kit: kick/4 hat/4 snare/4 hat/8t hat/8t hat/8t
    bar Bb C
      Lead{v=80}: D5/2 | E5/4 cc1=0>90/4 G5/4
      Keys{v=54}: [Bb3 D4{v=70} F4]/2 | [C4 E4 G4]/2{a=leg}
      Bass: Bb1/2 | C2/4. C2/8{d=60}
      Kit: kick/4 hat/4 | snare/4 ohat/4
  end
  bar A7 tempo=96>70
    Lead{v=76}: pedal+ [C#5 E5 A5]/1{a=leg} pedal-
    Keys{v=50}: *open/1{a=leg}
    Bass: A1/1{a=leg}
    Kit: crash/1
end

play pickup
play intro x2
play theme
play theme transpose=+2

at 0 Keys cc7=100
at 480 Lead "intro"
at 9600 tempo=88
at 9600 Bass G1 d=240 v=60
