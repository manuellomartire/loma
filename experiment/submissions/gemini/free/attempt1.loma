loma 1.0
title "Boss Fight - Scontro Finale"
tempo 140
meter 4/4
key Dm

track Mel ch=1 program=30
track Lead ch=2 program=38
track Pno ch=3 program=0
track Kit drums

pattern arp base=3 dur=/8 : 1 3 5 3 1 3 5 3
pattern arpFast base=3 dur=/16 : 1 3 5 8 5 3 1 0
pattern ost base=3 dur=/8 : 1 0 1 5 1 0 3 0

section intro
  bar Dm
    Mel{v=90}: pedal+ [D4 F4 A4]/1{a=leg} pedal-
    Lead{v=0}: r/1
    Pno{v=70}: use ost
    Kit{v=80}: kick/4 hat/4 kick/4 hat/4
  bar Dm tempo=140>180
    Mel{v=110}: D5/4{a=stac} F5/4{a=stac} A5/4{a=stac} C6/4{a=stac}
    Lead{v=80}: r/1
    Pno{v=75}: use ost
    Kit{v=90}: kick/4 snare/4 kick/4 snare/4
end

section fight
  bar Dm Bb
    Mel{v=120 o=-5}: D6/2{a=stac} | Bb5/2{a=stac}
    Lead{v=100}: D5/4 F5/4 A5/4 C6/4 | Bb4/4 D5/4 F5/4 A5/4
    Pno{v=80}: use arp | use arp
    Kit{v=100}: kick/4 hat/4 snare/4 hat/4 | kick/4 ohat/4 snare/4 crash/4
  bar C A
    Mel{v=110>90}: C6/2 | A5/2
    Lead{v=95}: C5/4 E5/4 G5/4 B5/4 | A4/4 C5/4 E5/4 G5/4
    Pno{v=80}: use arp | use arp
    Kit{v=100}: kick/4 hat/4 snare/4 hat/4 | kick/4 hat/4 snare/4 ohat/4
end

section climax
  bar Dm
    Mel{v=127}: pedal+ [D5 F5 A5 D6]/1{a=leg} pedal-
    Lead{v=110}: use arpFast
    Pno{v=90}: use arpFast
    Kit{v=110}: kick/4 snare/4 kick/4 snare/4
  bar Dm tempo=180>100
    Mel{v=120}: D6/1{a=leg}
    Lead{v=90}: A5/2{a=stac} F5/2{a=stac}
    Pno{v=70}: [D4 F4 A4]/1
    Kit{v=100}: crash/1
end

play intro
play fight x2
play climax
