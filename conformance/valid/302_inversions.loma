loma 0.3
tempo 120
meter 4/4
track P ch=1 program=0
pattern t base=3 dur=/2 : (1 3 5) 0
pattern t4 base=3 dur=/2 : (1 3 5 7) 0
section s
  bar C^0
    P: use t
  bar C^1
    P: use t
  bar C^2
    P: use t
  bar Cmaj7^3
    P: use t4
  bar Cmaj7^3/G
    P: use t4
  bar C13^5
    P: use t4
  bar Dm^1 G7^2
    P: D4/2 G4/2
end
play s
