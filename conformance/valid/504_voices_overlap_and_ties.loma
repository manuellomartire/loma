loma 1.1
tempo 60
meter 4/4
track P ch=1 program=0

section a
  bar C
    P: C4/1{a=leg}                # cut where the other voice plays the same pitch
    P: r/2 C4/4 r/4
  bar C
    P: E4/2~ E4/2~               # ties stay inside each voice
    P: G3/1~
  bar C meter=2/4
    P: E4/2
    P: G3/4 r/4
  bar C
    P: [C4 E4]/2
    P{v=30}: [G3 B3]/4 cc1=10>30/4 r/4
    P{v=20}: r/4 D5/4{o=-10}
end

play a
