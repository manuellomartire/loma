loma 0.1
tempo 120
meter 4/4
track P ch=1 program=0
pattern p base=3 dur=/4 : (1 3 5) (8 10 12)
pattern s7 base=4 dur=/2 : (1 3 5 7) 14
section s
  bar C Cm
    P: use p
  bar Cdim Caug
    P: use p
  bar Csus2 Csus4
    P: use p
  bar F#m Bb
    P: use p
  bar C7
    P: use s7
  bar Cmaj7
    P: use s7
  bar Cm7
    P: use s7
  bar Cb B#
    P: use p
end
play s
