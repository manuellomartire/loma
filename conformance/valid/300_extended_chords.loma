pattern t4 base=3 dur=/1 : (1 3 5 7)
pattern t5 base=3 dur=/1 : (1 3 5 7 9 16)
pattern t6 base=2 dur=/1 : (1 3 5 7 9 11 18)
section s
  bar Eb5
    P: use full
  bar Eb6
    P: use t4
  bar Ebm6
    P: use t4
  bar Ebdim7
    P: use t4
  bar Ebm7b5
    P: use t4
  bar Ebmmaj7
    P: use t4
  bar Eb7sus4
    P: use t4
  bar Eb7b9
    P: use t5
  bar Eb7#9
    P: use t5
  bar Ebadd9
    P: use t4
  bar Ebmadd9
    P: use t4
  bar Eb9
    P: use t5
  bar Ebmaj9
    P: use t5
  bar Ebm9
    P: use t5
  bar Eb11
    P: use t6
  bar Ebm11
    P: use t6
  bar Eb13
