loma 0.1
track P ch=1
swing s grid=/8 : 0 1
pattern a base=3 dur=/4 : 1
pattern b from a : 1=3
section s
  bar C
    P: cc7=1 C4/1
  bar C
    P: bend=0 C4/1
  bar C
    P{v=1>9}: C4/1
  bar C
    P{swing=s}: C4/1
  bar C
    P:
      C4/1
  bar C F
    P: C4/2 | F4/2
  bar C
    P: C4/4x5/4 r/#1536
  bar C
    P: C4/8q r/#1728
  bar C
    P: use a,a
  repeat 2
    bar C
      P: C4/1
  end
  bar C len=/4q
    P: C4/4q
end
